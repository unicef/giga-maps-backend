FROM python:3.8-bullseye

# Install dependencies
RUN apt-get update
RUN apt-get install -y --no-install-recommends \
    build-essential \
    libcurl4-openssl-dev \
    libjpeg-dev \
    vim \
    ntp \
    libpq-dev
RUN apt-get install -y --no-install-recommends \
    git-core
RUN apt-get install -y --no-install-recommends \
    postgresql-client \
    libpq-dev \
    python3-psycopg2
RUN apt-get install -y --no-install-recommends \
    python3-gdal \
    gdal-bin \
    libgdal-dev \
    libgdal28 \
    libxml2-dev \
    libxslt-dev \
    xmlsec1

RUN pip install --upgrade \
    setuptools \
    pip \
    wheel \
    pipenv

ENV PYTHONUNBUFFERED 1
ENV PYTHONPATH /code

ADD Pipfile /code/Pipfile
ADD Pipfile.lock /code/Pipfile.lock

WORKDIR /code/

RUN PIP_NO_CACHE_DIR=1 pipenv install --dev --ignore-pipfile

EXPOSE 8000
